<?xml version="1.0" encoding="UTF-8"?>
<configuration>
    <Appenders>
        <Console name="Console" target="SYSTEM_OUT">
            <PatternLayout charset="UTF-8" pattern="[%-5p] %d %c - %m%n"/>
        </Console>

        <RollingFile name="RollingFile" fileName="/root/data/corgi-user/logs/corgi-user.log"
                     filePattern="/root/data/corgi-user/logs/corgi-user-%d{yyyy-MM-dd}.log"
                     filePermissions="rw-r--r--">
            <PatternLayout alwaysWriteExceptions="true"
                           pattern="%d{yyyy.MM.dd 'at' HH:mm:ss z} %-5level %class{36} %L %M requestId: %X{reqId} - userID : %X{usrID} %msg%dT%xEx%n"/>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="100 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="/root/data/corgi-user/logs/" maxDepth="2">
                    <IfFileName glob="corgi-user*.log"/>
                    <IfLastModified age="24H"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
        <RollingFile name="ErrorRollingFile" fileName="/root/data/corgi-user/logs/corgi-user-error.log"
                     filePattern="/root/data/corgi-user/logs/corgi-user-error-%d{yyyy-MM-dd}.log"
                     filePermissions="rw-r--r--">
            <PatternLayout alwaysWriteExceptions="false"
                           pattern="%d{yyyy.MM.dd 'at' HH:mm:ss z} %-5level %class{36} %L %M requestId: %X{reqId} - userID : %X{usrID} %msg%dT%xEx%n"/>
            <Filters>
                <ThresholdFilter level="ERROR" onMatch="ACCEPT" onMismatch="DENY"/>
            </Filters>
            <Policies>
                <TimeBasedTriggeringPolicy interval="1"/>
                <SizeBasedTriggeringPolicy size="200 MB"/>
            </Policies>
            <DefaultRolloverStrategy max="30">
                <Delete basePath="/root/data/corgi-user/logs/" maxDepth="2">
                    <IfFileName glob="corgi-user-error*.log"/>
                    <IfLastModified age="36H"/>
                </Delete>
            </DefaultRolloverStrategy>
        </RollingFile>
    </Appenders>

    <Loggers>
        <Logger name="com.corgi" level="debug" additivity="false">
            <AppenderRef ref="RollingFile"/>
        </Logger>
        <!--<Logger name="com.corgi" level="error" additivity="false">-->
            <!--<AppenderRef ref="ErrorRollingFile"/>-->
        <!--</Logger>-->
        <Root level="info">
            <AppenderRef ref="RollingFile"/>
            <AppenderRef ref="ErrorRollingFile"/>
        </Root>
    </Loggers>
</configuration>