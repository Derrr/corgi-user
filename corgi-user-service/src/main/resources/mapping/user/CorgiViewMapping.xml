<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiViewMapper">

    <insert id="addView" parameterType="com.corgi.user.entity.ActivityView">
        insert ignore into `corgi`.`corgi_activity_view` (`user_id`, `activity_id`)
        values (#{view.userId}, #{view.activityId});
    </insert>

    <update id="addViewCount" >
        update corgi_activity_view set view_count = view_count+1
        where user_id = #{userId} and activity_id = #{activityId}
    </update>

</mapper>