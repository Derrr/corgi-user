<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiInfluencerApplyMapper">
    <sql id="apply">
        id
        ,
        user_id
        userId,
        nickname,
        wechat,
        avatar,
        status,
        ctime,
        uptime
    </sql>
    <insert id="addApply" parameterType="com.corgi.user.entity.InfluencerApply">
        INSERT INTO `corgi_influencer_apply` (`user_id`, `nickname`, `wechat`, `avatar`)
        VALUES (#{apply.userId}, #{apply.nickname}, #{apply.wechat}, #{apply.avatar});
    </insert>

    <insert id="updateApply" parameterType="com.corgi.user.entity.InfluencerApply">
        update corgi_influencer_apply
        <set>
            <if test="apply.status != null and apply.status != ''">
                `status` = #{apply.status},
            </if>
            <if test="apply.wechat != null and apply.wechat != ''">
                `wechat` = #{apply.wechat},
            </if>
        </set>
        where id = #{apply.id}
    </insert>

    <select id="getApplies" resultType="com.corgi.user.entity.InfluencerApply">
        select
        <include refid="apply"/>
        from corgi_influencer_apply
        where 1=1
        <if test="apply.status != null and apply.status != ''">
            and status = #{apply.status}
        </if>
        <if test="apply.userId != null and apply.userId != ''">
            and user_id = #{apply.userId}
        </if>
        order by id desc limit #{start}, #{size}
    </select>

    <select id="countApplies" resultType="java.lang.Integer">
        select
        count(1)
        from corgi_influencer_apply
        where 1=1
        <if test="apply.status != null and apply.status != ''">
            and status = #{apply.status}
        </if>
        <if test="apply.userId != null and apply.userId != ''">
            and user_id = #{apply.userId}
        </if>
    </select>

</mapper>