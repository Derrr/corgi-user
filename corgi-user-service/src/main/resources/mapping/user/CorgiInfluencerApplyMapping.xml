<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiInfluencerApplyMapper">
    <sql id="apply">
        corgi_nickname
        corgiNickname,
        weichat_nickname weichatNickname,
        height,
        weight,
        age,
        city,
        pic1,
        pic2,
        tiktok,
        instagram,
        weibo,
        snapshot1,
        desc1,
        snapshot2,
        desc2,
        `source`,
        detail
    </sql>
    <insert id="addApply" parameterType="com.corgi.user.entity.InfluencerApply">
        INSERT INTO `corgi_influencer_apply` (`corgi_nickname`, `wechat_nickname`, `height`, `weight`, `age`, `city`,
                                              `pic1`, `pic2`, `tiktok`, `instagram`, `weibo`, `snapshot1`, `desc1`,
                                              `snapshot2`, `desc2`, `source`, `detail`)
        VALUES (#{apply.corgiNickname}, #{apply.weichatNickname}, #{apply.height}, #{apply.weight}, #{apply.age},
                #{apply.city}, #{apply.pic1}, #{apply.pic2}, #{apply.tiktok}, #{apply.instagram}, #{apply.weibo},
                #{apply.snapshot1}, #{apply.desc1}, #{apply.snapshot2}, #{apply.desc2}, #{apply.source},
                #{apply.detail});
    </insert>

    <select id="getApplies" resultType="com.corgi.user.entity.InfluencerApply">
        select
        <include refid="apply"/>
        from corgi_influencer_apply
        order by id desc limit #{start}, #{size}
    </select>

</mapper>