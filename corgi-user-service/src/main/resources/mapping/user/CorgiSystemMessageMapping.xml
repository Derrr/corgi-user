<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiSystemMessageMapper">
    <select id="getSystemMessageByPage" resultType="com.corgi.user.entity.SystemMessage">
        select `id`,
               `content`,
               `type`,
               `pic_url`   picUrl,
               `url`,
               `url_type`  urlType,
               `sent_time` sentTime,
               `status`,
               `ctime`,
               `title`,
               `uptime`
        from corgi_system_message
        where 1=1
        <if test="filterTitle != null and filterTitle != ''">
            and title not like concat('%',#{filterTitle},'%')
        </if>
        order by id desc
            limit #{start}, #{size}
    </select>

    <select id="countSystemMessage" resultType="java.lang.Integer">
        select count(1)
        from corgi_system_message
        where 1=1
        <if test="filterTitle != null and filterTitle != ''">
            and title not like concat('%',#{filterTitle},'%')
        </if>
    </select>

    <select id="getSystemMessageById" resultType="com.corgi.user.entity.SystemMessage">
        select `id`,
               `content`,
               `type`,
               `pic_url`   picUrl,
               `url`,
               `url_type`  urlType,
               `sent_time` sentTime,
               `status`,
               `ctime`,
               `title`,
               `uptime`
        from corgi_system_message
        where id = #{messageId}
    </select>

    <select id="getSystemMessageByTime" resultType="com.corgi.user.entity.SystemMessage">
        select `id`,
               `content`,
               `type`,
               `pic_url`   picUrl,
               `url`,
               `url_type`  urlType,
               `sent_time` sentTime,
               `status`,
               `ctime`,
               `title`,
               `uptime`
        from corgi_system_message
        where sent_time &lt;= #{time}
          and `status` = #{status}
    </select>

    <insert id="addSystemMessage" useGeneratedKeys="true" keyProperty="message.id"
            parameterType="com.corgi.user.entity.SystemMessage">
        insert into corgi_system_message (`content`, `sent_time`, `status`, `title`, `type`, `pic_url`, `url_type`,
                                          `url`)
        VALUES (#{message.content}, #{message.sentTime}, #{message.status}, #{message.title}, #{message.type},
                #{message.picUrl}, #{message.urlType}, #{message.url})
    </insert>

    <update id="updateSystemMessage" parameterType="com.corgi.user.entity.SystemMessage">
        update corgi_system_message
        <set>
            <if test="message.content != null and message.content != ''">
                `content` = #{message.content},
            </if>
            <if test="message.sentTime != null">
                `sent_time` = #{message.sentTime},
            </if>
            <if test="message.status != null and message.status != ''">
                `status` = #{message.status},
            </if>
            <if test="message.title != null and message.title != ''">
                `title` = #{message.title},
            </if>
            <if test="message.type != null and message.type != ''">
                `type` = #{message.type},
            </if>
            <if test="message.url != null and message.url != ''">
                `url` = #{message.url},
            </if>
            <if test="message.urlType != null and message.urlType != ''">
                `url_type` = #{message.urlType},
            </if>
            <if test="message.picUrl != null and message.picUrl != ''">
                `pic_url` = #{message.picUrl},
            </if>
        </set>
        where id = #{message.id}
    </update>

    <select id="getMessageRuleById" resultType="com.corgi.user.entity.MessageRule">
        select `message_id` messageId,
               `rule_key`   ruleKey,
               `rule_value` ruleValue
        from corgi_message_rule
        where message_id = #{messageId}
    </select>

    <insert id="addMessageRule" parameterType="com.corgi.user.entity.MessageRule">
        INSERT INTO `corgi_message_rule` (`message_id`, `rule_key`, `rule_value`)
        VALUES (#{rule.messageId}, #{rule.ruleKey}, #{rule.ruleValue});
    </insert>

    <delete id="deleteMessageRule">
        delete
        from corgi_message_rule
        where message_id = #{messageId}
    </delete>

    <select id="getMessageRecordByPage" resultType="com.corgi.user.entity.MessageRecord">
        select `id`,
               `message_id` messageId,
               `user_id`    userId,
               `nickname`,
               `status`,
               `reason`,
               `ctime`
        from corgi_message_record
        order by id DESC
            limit #{start}, #{size}
    </select>

    <select id="getMessageRecordByMessageId" resultType="com.corgi.user.entity.MessageRecord">
        select `id`,
               `message_id` messageId,
               `user_id`    userId,
               `nickname`,
               `status`,
               `reason`,
               `ctime`
        from corgi_message_record
        where message_id = #{messageId}
        order by id DESC
            limit #{start}, #{size}
    </select>

    <select id="countMessageRecordByMessageId" resultType="java.lang.Integer">
        select count(1)
        from corgi_message_record
        where message_id = #{messageId}
    </select>

    <insert id="addMessageRecord" useGeneratedKeys="true" keyProperty="record.id"
            parameterType="com.corgi.user.entity.MessageRecord">
        INSERT INTO `corgi_message_record` (`message_id`, `user_id`, `nickname`, `status`, `reason`)
        VALUES (#{record.messageId}, #{record.userId}, #{record.nickname}, #{record.status}, #{record.reason});
    </insert>

    <update id="updateMessageRecord" parameterType="com.corgi.user.entity.MessageRecord">
        update corgi_message_record
        <set>
            <if test="record.status != null and record.status != ''">
                `status` = #{record.status},
            </if>
            <if test="record.reason != null and record.reason != ''">
                `reason` = #{record.reason},
            </if>
        </set>
        where id = #{record.id}
    </update>

    <select id="searchMessageRecord" resultType="com.corgi.user.entity.MessageRecord">
        select `id`,
        `message_id` messageId,
        `user_id` userId,
        `nickname`,
        `status`,
        `reason`,
        `ctime`
        from corgi_message_record
        where 1=1
        <if test="record.status != null and record.status != ''">
            and `status` = #{record.status}
        </if>
        <if test="record.nickname != null and record.nickname != ''">
            and `nickname` like concat('%',#{record.nickname},'%')
        </if>
        <if test="record.userId != null and record.userId != ''">
            and `user_id` = #{record.userId}
        </if>
        <if test="record.ctime != null and record.ctime != ''">
            and `ctime` like concat(#{record.ctime},'%')
        </if>
        <if test="record.messageId != null and record.messageId != ''">
            and `message_id` = #{record.messageId}
        </if>
        order by id desc
        limit #{start}, #{size}
    </select>

    <select id="countMessageRecord" resultType="java.lang.Integer">
        select count(1)
        from corgi_message_record
        where 1=1
        <if test="record.status != null and record.status != ''">
            and `status` = #{record.status}
        </if>
        <if test="record.nickname != null and record.nickname != ''">
            and `nickname` like concat('%',#{record.nickname},'%')
        </if>
        <if test="record.userId != null and record.userId != ''">
            and `user_id` = #{record.userId}
        </if>
        <if test="record.ctime != null and record.ctime != ''">
            and `ctime` like concat(#{record.ctime},'%')
        </if>
    </select>
</mapper>