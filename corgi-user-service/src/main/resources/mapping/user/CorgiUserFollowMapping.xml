<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiUserFollowMapper">

    <insert id="addFollowUser">
        insert ignore into corgi_user_follow (`user_id`, `follow_user_id`)
        values (#{userId}, #{followId});
    </insert>

    <delete id="deleteFollowUser">
        delete from corgi_user_follow
        where user_id = #{userId} and follow_user_id = #{followId}
    </delete>

    <select id="countFollow" resultType="java.lang.Integer">
        select count(1) from corgi_user_follow
        where user_id = #{userId1} and follow_user_id = #{userId2}
    </select>
</mapper>