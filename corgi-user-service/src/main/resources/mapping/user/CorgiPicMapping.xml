<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiPicMapper">

    <insert id="addUserPic" useGeneratedKeys="true" keyProperty="userPic.picId"
            parameterType="com.corgi.user.entity.UserPic">
        insert into corgi_user_pic (`user_id`, `pic_url`, `data_id`, `status`, `result`)
        values (#{userPic.userId}, #{userPic.picUrl}, #{userPic.dataId}, #{userPic.status}, #{userPic.result})
    </insert>

    <delete id="deleteUserPic">
        delete from corgi_user_pic
        where id = #{picId}
        <if test="userId != ''">
            and user_id = #{userId}
        </if>
    </delete>

    <update id="updateUserPic">
        update corgi_user_pic set
        `status` = #{pic.status},
        data_id = #{pic.dataId},
        pic_url = #{pic.picUrl},
        `result` = #{pic.result}
        where id = #{pic.picId}
        <if test='pic.userId != ""'>
            and user_id = #{pic.userId}
        </if>
    </update>

    <delete id="deleteUserPicByDataId">
        delete
        from corgi_user_pic
        where data_id = #{dataId}
    </delete>

    <update id="updateUserPicByDataId">
        update corgi_user_pic
        set `status` = #{status}
        where data_id = #{dataId}
    </update>

    <select id="getUserPicByDataId" resultType="com.corgi.user.entity.UserPic">
        select id picId, user_id userId, pic_url picUrl, data_id dataId, `status`, `result`
        from corgi_user_pic
        where data_id = #{dataId}
    </select>

    <select id="getUserPic" resultType="com.corgi.user.entity.UserPic">
        select id picId, user_id userId, pic_url picUrl, data_id dataId, `status`, `result`
        from corgi_user_pic
        where user_id = #{userId}
    </select>

    <insert id="addActivityPic" useGeneratedKeys="true" keyProperty="activityPic.picId" keyColumn="id"
            parameterType="com.corgi.activity.entity.ActivityPic">
        insert into corgi_activity_pic (`activity_id`, `pic_url`, `data_id`, `status`, `result`)
        values (#{activityPic.activityId}, #{activityPic.picUrl}, #{activityPic.dataId}, #{activityPic.status},
                #{activityPic.result})
    </insert>

    <delete id="deleteActivityPic">
        delete
        from corgi_activity_pic
        where id = #{picId}
    </delete>

    <select id="getActivityPicByDataId" resultType="com.corgi.activity.entity.ActivityPic">
        select `activity_id` activityId, `pic_url` picUrl, `data_id` dataId, `status`, `result`
        from corgi_activity_pic
        where data_id = #{dataId}
    </select>

    <delete id="deleteActivityPicByDataId">
        delete
        from corgi_activity_pic
        where data_id = #{dataId}
    </delete>

    <update id="updateActivityPicByDataId">
        update corgi_activity_pic
        set `status` = #{status}
        where data_id = #{dataId}
    </update>

    <update id="updateActivityPicByActivityId">
        update corgi_activity_pic
        set `status` = #{status}
        where activity_id = #{activityId}
    </update>


    <select id="getActivityPic" resultType="com.corgi.activity.entity.ActivityPic">
        select id picId, activity_id activityId, pic_url picUrl, data_id dataId, `status`, `result`
        from corgi_activity_pic
        where activity_id = #{activityId}
    </select>

    <insert id="addCheckPic" useGeneratedKeys="true" keyProperty="checkPic.picId" keyColumn="id"
            parameterType="com.corgi.entity.CheckPic">
        insert
        ignore into `corgi_check_pic` (`data_id`, `pic_url`, `type`, `result`, `status`, `source_id`)
        values (
        #{checkPic.dataId},
        #{checkPic.picUrl},
        #{checkPic.type},
        #{checkPic.result},
        #{checkPic.status},
        #{checkPic.userId}
        );
    </insert>

    <update id="updateCheckPic">
        update corgi_check_pic
        set `status` = #{status},
            opuid    = #{userId}
        where data_id = #{dataId}
    </update>

    <select id="countCheckPic" resultType="java.lang.Long">
        select count(1) from corgi_check_pic c
        where 1=1
        <if test="status != null and status != ''">
            and c.`status` = #{status}
        </if>
        <if test="type != null and type != ''">
            and c.`type` = #{type}
        </if>
        <if test="userId != null and userId != ''">
            and c.source_id = #{userId}
        </if>
    </select>

    <select id="getCheckPic" resultType="com.corgi.entity.CheckPic">
        select c.id picId, c.data_id dataId, c.pic_url picUrl, c.`type`, c.`source_id` userId,
        c.`result`, c.`status`, c.ctime, c.uptime
        from corgi_check_pic c
        where 1=1
        <if test="status != null and status != ''">
            and c.`status` = #{status}
        </if>
        <if test="type != null and type != ''">
            and c.`type` = #{type}
        </if>
        <if test="userId != null and userId != ''">
            and c.source_id = #{userId}
        </if>
        limit #{start}, #{size}
    </select>

    <select id="getCheckPicBySourceId" resultType="com.corgi.entity.CheckPic">
        select id          picId,
               data_id     dataId,
               pic_url     picUrl,
               `type`,
               `source_id` userId,
               `result`,
               `status`,
               ctime,
               uptime
        from corgi_check_pic
        where `type` = #{type}
          and `source_id` = #{sourceId}
    </select>

    <select id="getCheckPicByDataId" resultType="com.corgi.entity.CheckPic">
        select id          picId,
               data_id     dataId,
               pic_url     picUrl,
               `type`,
               `source_id` userId,
               `result`,
               `status`,
               ctime,
               uptime
        from corgi_check_pic
        where `data_id` = #{dataId}
    </select>

</mapper>