<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE mapper PUBLIC "-//mybatis.org//DTD Mapper 3.0//EN" "http://mybatis.org/dtd/mybatis-3-mapper.dtd">
<mapper namespace="com.corgi.mapper.CorgiToolMapper">
    <select id="searchTopic" resultType="com.corgi.entity.CorgiTopic">
        select id topicId, `topic`, ctime, uptime, `status`, cuid, opuid, `content`
        from corgi_topics
        where `status` != 'deleted'
        <if test="status != null and status != ''">
            and `status` = #{status}
        </if>
        <if test="text != null and text != ''">
            and `topic` like concat('%',#{text},'%')
        </if>
        order by id desc
    </select>

    <insert id="addTopic" parameterType="com.corgi.entity.CorgiTopic">
        insert into `corgi_topics` (`topic`,`status`, cuid, opuid, `content`)
        values (#{topic.topic}, #{topic.status}, #{topic.cuid}, #{topic.opuid}, #{topic.content});
    </insert>

    <update id="updateTopic" parameterType="com.corgi.entity.CorgiTopic">
        update corgi_topics
        set topic = #{topic.topic}, content = #{topic.content}, opuid = #{topic.opuid}, `status` = #{topic.status}
        where id = #{topic.topicId}
    </update>

    <select id="getActivityTopic" resultType="java.lang.String">
        select topic from corgi_activity_topic
        where activity_id = #{activityId}
    </select>

    <insert id="addActivityTopic">
        insert ignore into corgi_activity_topic(`activity_id`, `topic`)
        values (#{activityId}, #{topic});
    </insert>

    <delete id="deleteActivityTopic">
        delete from corgi_activity_topic
        where activity_id = #{activityId}
    </delete>

    <insert id="addCountByUser">
        INSERT INTO `corgi_count_influencer` (`user`, `count`)
        VALUES (#{user}, #{count});
    </insert>

    <select id="getCountByUser" resultType="java.lang.Integer">
        select `count` from corgi_count_influencer
        where `user` = #{user}
    </select>

    <update id="updateCountByUser">
        update corgi_count_influencer
        set `count` = #{count}
        where `user` = #{user}
    </update>

    <select id="getAllInfluencer">
        select `user`, `count` from corgi_count_influencer
        limit 2000
    </select>
</mapper>
